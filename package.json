{
	"name": "startpage",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build && cp manifest.json dist/",
		"preview": "vite preview",
		"knip": "knip",
		"knip:report": "knip --no-exit-code",
		"knip:fix": "knip --fix",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@types/chrome": "^0.1.38",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"knip": "^6.3.0",
		"typescript": "~5.9.3",
		"vite": "^8.0.1"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.96.2",
		"clsx": "^2.1.1",
		"react": "^19.2.4",
		"react-aria-components": "^1.16.0",
		"react-dom": "^19.2.4"
	}
}
